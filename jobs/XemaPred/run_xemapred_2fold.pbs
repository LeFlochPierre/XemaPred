#!/bin/bash
#PBS -q v1_large72
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=16:mem=32gb

set -euo pipefail

: "${CONFIG_YAML:?CONFIG_YAML env var is required (passed via qsub -v CONFIG_YAML=...)}"

eval "$(~/anaconda3/bin/conda shell.bash hook)"
conda activate RENV

cd "$PBS_O_WORKDIR"

echo "======================================"
echo "2-fold XemaPred job started on $(hostname) at $(date)"
echo "PBS_JOBID: ${PBS_JOBID:-unknown}"
echo "Working directory: $PBS_O_WORKDIR"
echo "CONFIG_YAML: $CONFIG_YAML"
echo "DATASET: ${DATASET:-unknown}"
echo "SIGN: ${SIGN:-unknown}"
echo "FOLD: ${FOLD:-unknown}"
echo "HORIZON: ${HORIZON:-unknown}"
echo "======================================"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

JOB_NUM="$(echo "${PBS_JOBID:-$$}" | sed 's/[^0-9].*//')"

if [[ -z "$JOB_NUM" ]]; then
  JOB_NUM="$$"
fi

export R_PARALLEL_PORT=$((20000 + (JOB_NUM % 30000)))

echo "R_PARALLEL_PORT: $R_PARALLEL_PORT"

RUNNER="scripts/01_run_models/XemaPredV2/run_validation.R"

if [[ ! -f "$RUNNER" ]]; then
  echo "[ERROR] Could not find XemaPred runner:"
  echo "  $RUNNER"
  exit 1
fi

echo "Using runner: $RUNNER"

Rscript "$RUNNER" "$CONFIG_YAML"

echo "2-fold XemaPred job finished at $(date)"