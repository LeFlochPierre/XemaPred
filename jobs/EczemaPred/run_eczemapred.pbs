#!/bin/bash
#PBS -q v1_large24
#PBS -l walltime=8:00:00
#PBS -l select=1:ncpus=16:mem=32gb

set -euo pipefail

: "${CONFIG_YAML:?CONFIG_YAML env var is required}"

eval "$(~/anaconda3/bin/conda shell.bash hook)"
conda activate RENV

cd "$PBS_O_WORKDIR"

echo "======================================"
echo "EczemaPred job started on $(hostname) at $(date)"
echo "Working directory: $PBS_O_WORKDIR"
echo "CONFIG_YAML: $CONFIG_YAML"
echo "======================================"

# --- avoid thread oversubscription ---
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# --- Stan chains per foreach worker ---
export R_STAN_CORES="${R_STAN_CORES:-4}"
export MC_CORES="${MC_CORES:-4}"

# --- avoid R PSOCK port collisions ---
JOB_NUM="$(echo "${PBS_JOBID:-$$}" | sed 's/[^0-9].*//')"

if [[ -z "$JOB_NUM" ]]; then
  JOB_NUM="$$"
fi

export R_PARALLEL_PORT=$((20000 + (JOB_NUM % 30000)))

echo "R_PARALLEL_PORT: $R_PARALLEL_PORT"
echo "R_STAN_CORES: $R_STAN_CORES"
echo "MC_CORES: $MC_CORES"

which Rscript
Rscript --version

Rscript scripts/01_run_models/EczemaPred/run_validation.R "$CONFIG_YAML"

echo "EczemaPred job finished at $(date)"